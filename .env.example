# Settings for scripts/setup.py and scripts/doctor.py.
# Copy to .env (cp .env.example .env) or just run `python3 scripts/setup.py`:
# it asks for anything missing and writes the answers back here.
# .env is git-ignored. Never commit it.

# Address you open n8n at, e.g. https://n8n.example.com (no trailing slash).
# Must be public https if you use Telegram.
N8N_URL=

# n8n → Settings → n8n API → Create API key
N8N_API_KEY=

# Secret Claude sends in the X-Claude-Key header. Leave empty and setup generates one.
WEBHOOK_KEY=

# From your app at https://www.linkedin.com/developers/apps → Auth.
# The app needs the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# From @BotFather on Telegram. Leave empty to run without Telegram (notifications and approvals off).
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID. Leave empty and setup detects it when you message your bot.
TELEGRAM_CHAT_ID=

# IANA time zone for the schedules (queue, morning digest, nightly cleanup).
TIMEZONE=Europe/Paris

# Empty at first. After connecting LinkedIn in n8n, run: python3 scripts/setup.py person <ID>
LINKEDIN_PERSON_ID=

# ---------------------------------------------------------------------------
# Filled in by setup.py so re-runs reuse what already exists. Leave them empty.
# ---------------------------------------------------------------------------
N8N_WORKFLOW_ID=
N8N_POSTS_TABLE_ID=
N8N_IDEAS_TABLE_ID=
N8N_SETTINGS_TABLE_ID=
N8N_LINKEDIN_CREDENTIAL_ID=
N8N_WEBHOOK_CREDENTIAL_ID=
N8N_TELEGRAM_CREDENTIAL_ID=
