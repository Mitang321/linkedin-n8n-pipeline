# Copy this file to .env and fill in both values.

# The domain n8n will live on, without https://
# Before starting, create a DNS A record for this name pointing at your
# server's public IP, and make sure ports 80 and 443 are open in the server
# firewall (and in your cloud provider's security list, if it has one).
# Caddy needs both to get the HTTPS certificate.
N8N_DOMAIN=n8n.example.com

# Your time zone, as an IANA name (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
# Used by n8n for schedules and by the workflow for the 08:00 summary,
# 03:00 cleanup and 09:00 login reminder.
TIMEZONE=Europe/Paris
